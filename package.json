{
  "name": "bunnyhop-client",
  "version": "0.2.0",
  "description": "Desktop client for bunnyhop.lol",
  "author": {
    "name": "Aeperion",
    "email": "8tp@users.noreply.github.com"
  },
  "desktopName": "Bunnyhop",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "electron:start": "electron .",
    "electron:smoke": "node electron/run-smoke.mjs",
    "electron:packaged-smoke": "node electron/run-packaged-smoke.mjs",
    "electron:gpu": "electron electron/gpu-report.mjs",
    "electron:pack": "electron-builder --config electron/electron-builder.yml --dir",
    "electron:dist": "electron-builder --config electron/electron-builder.yml",
    "start": "electron .",
    "test": "node --test electron/test/*.test.mjs",
    "check": "node electron/check.mjs",
    "verify": "npm run check && npm test",
    "release:keygen": "node scripts/release.mjs keygen",
    "release:build": "electron-builder --config electron/electron-builder.yml -c.extraMetadata.bunnyhopReleaseBuild=true --publish never",
    "release:manifest": "node scripts/release.mjs manifest",
    "release:draft": "node scripts/release.mjs draft"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.28.2": true
  },
  "homepage": "https://bunnyhop.lol",
  "repository": {
    "type": "git",
    "url": "https://github.com/8tp/bunnyhop-client.git"
  },
  "bugs": {
    "url": "https://github.com/8tp/bunnyhop-client/issues"
  }
}
